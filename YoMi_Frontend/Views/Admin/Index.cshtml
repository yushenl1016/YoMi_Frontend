@model AdminPageViewModel
@{
    ViewData["Title"] = "管理後台";
    string TabClass(string tab) => Model.ActiveTab == tab ? "is-active" : string.Empty;
}

<header class="page-hero admin-hero"><div class="hero-grid"></div><div class="container"><p class="eyebrow">ADMIN CONSOLE</p><h1>管理後台</h1><p>管理會員、消費紀錄、價目表、網站設定與背景素材。</p></div></header>

<section class="page-content admin-page">
    <div class="container">
        <div class="stats-grid">
            <article><span>會員總數</span><strong>@Model.Stats.TotalUsers</strong></article>
            <article><span>VIP 會員</span><strong>@Model.Stats.VipMembers</strong></article>
            <article><span>總消費金額</span><strong>NT$@Model.Stats.TotalSpending.ToString("N0")</strong></article>
            <article><span>平均消費</span><strong>NT$@Model.Stats.AverageSpending.ToString("N0")</strong></article>
        </div>

        <nav class="admin-tabs">
            <a class="@TabClass("users")" href="/admin?tab=users">會員消費</a>
            <a class="@TabClass("price")" href="/admin?tab=price">價目表</a>
            <a class="@TabClass("settings")" href="/admin?tab=settings">網站設定</a>
            <a class="@TabClass("background")" href="/admin?tab=background">背景素材</a>
            <a class="@TabClass("admins")" href="/admin?tab=admins">權限管理</a>
        </nav>

        @if (Model.ActiveTab == "users")
        {
            <section class="admin-section">
                <div class="admin-section-heading"><div><p class="eyebrow">MEMBERS</p><h2>會員與消費</h2></div><form class="search-form" method="get"><input type="hidden" name="tab" value="users" /><input name="search" value="@Model.Search" placeholder="搜尋用戶名稱或信箱" /><button type="submit">搜尋</button></form></div>
                <div class="admin-split">
                    <div class="member-list">
                        @if (Model.Members.Count == 0) { <div class="empty-state">沒有符合的會員</div> }
                        @foreach (var item in Model.Members)
                        {
                            <a class="member-row @(Model.SelectedMember?.Id == item.Member.Id ? "is-active" : "")" href="/admin?tab=users&amp;memberId=@item.Member.Id&amp;search=@Uri.EscapeDataString(Model.Search)"><span class="profile-avatar small">@item.Member.Name.Substring(0, 1).ToUpperInvariant()</span><span><strong>@item.Member.Name</strong><small>@item.Member.Email</small></span><span class="member-total"><b class="@item.Status.Tier.CssClass">@item.Status.Tier.Icon @item.Status.Tier.Name</b><small>NT$@item.Total.ToString("N0")</small></span></a>
                        }
                    </div>
                    <div class="record-editor">
                        @if (Model.SelectedMember == null)
                        {
                            <div class="empty-state">選擇會員以管理消費紀錄</div>
                        }
                        else
                        {
                            <h3>@Model.SelectedMember.Name · 消費紀錄</h3>
                            <form class="admin-form form-grid" action="/admin/consumption/add" method="post">
                                @Html.AntiForgeryToken()<input type="hidden" name="userId" value="@Model.SelectedMember.Id" />
                                <label>金額<input name="amount" type="number" min="0.01" step="0.01" required /></label>
                                <label>類別<select name="category"><option>一般消費</option><option>代練</option><option>趣味單</option><option>代儲</option><option>訂製</option></select></label>
                                <label class="wide">說明<input name="description" maxlength="1000" /></label><button class="primary-button" type="submit">新增消費</button>
                            </form>
                            <div class="admin-records">
                                @if (Model.SelectedRecords.Count == 0) { <div class="empty-state">無消費紀錄</div> }
                                @foreach (var record in Model.SelectedRecords)
                                {
                                    <div class="editable-row">
                                        <form action="/admin/consumption/update" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@record.Id" /><input type="hidden" name="userId" value="@Model.SelectedMember.Id" /><input name="amount" type="number" min="0.01" step="0.01" value="@record.Amount" required /><input name="category" maxlength="64" value="@record.Category" required /><input name="description" maxlength="1000" value="@record.Description" /><button type="submit">儲存</button></form>
                                        <form action="/admin/consumption/delete" method="post" data-confirm="確定刪除此消費紀錄？">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@record.Id" /><input type="hidden" name="userId" value="@Model.SelectedMember.Id" /><button class="danger-button" type="submit">刪除</button></form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
        else if (Model.ActiveTab == "price")
        {
            <section class="admin-section">
                <div class="admin-section-heading"><div><p class="eyebrow">PRICE LIST</p><h2>價目表管理</h2></div><nav class="tab-nav">@foreach (var tab in new[] { "基礎", "趣味", "訂製" }) { <a class="@(Model.PriceTab == tab ? "is-active" : "")" href="/admin?tab=price&amp;priceTab=@Uri.EscapeDataString(tab)">@tab</a> }</nav></div>
                <form class="admin-form form-grid four" action="/admin/price/add" method="post">@Html.AntiForgeryToken()<input type="hidden" name="priceTab" value="@Model.PriceTab" /><label>服務名稱<input name="name" maxlength="128" required /></label><label>價格<input name="price" maxlength="64" required /></label><label>備註<input name="note" maxlength="512" /></label><button class="primary-button" type="submit">新增項目</button></form>
                <div class="admin-list">
                    @foreach (var item in Model.PriceItems)
                    {
                        <div class="editable-row price-edit-row">
                            <form action="/admin/price/update" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="priceTab" value="@Model.PriceTab" /><input name="name" maxlength="128" value="@item.Name" required /><input name="price" maxlength="64" value="@item.Price" required /><input name="note" maxlength="512" value="@item.Note" /><button type="submit">儲存</button></form>
                            <div class="row-actions"><form action="/admin/price/move" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="priceTab" value="@Model.PriceTab" /><input type="hidden" name="direction" value="-1" /><button type="submit" aria-label="上移">↑</button></form><form action="/admin/price/move" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="priceTab" value="@Model.PriceTab" /><input type="hidden" name="direction" value="1" /><button type="submit" aria-label="下移">↓</button></form><form action="/admin/price/delete" method="post" data-confirm="確定刪除此價目項目？">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="priceTab" value="@Model.PriceTab" /><button class="danger-button" type="submit">刪除</button></form></div>
                        </div>
                    }
                    @if (Model.PriceItems.Count == 0) { <div class="empty-state">此分類尚無項目</div> }
                </div>
            </section>
        }
        else if (Model.ActiveTab == "settings")
        {
            <section class="admin-section"><div class="admin-section-heading"><div><p class="eyebrow">SITE SETTINGS</p><h2>網站設定</h2></div></div><div class="settings-list">
                @foreach (var setting in Model.Settings)
                {
                    <form class="setting-row" action="/admin/setting/update" method="post">@Html.AntiForgeryToken()<input type="hidden" name="key" value="@setting.Key" /><label><strong>@setting.Label</strong><small>@setting.Description</small></label><textarea name="value" rows="@(setting.Key == "site_description" ? 4 : 2)">@setting.Value</textarea><button type="submit">儲存</button></form>
                }
            </div></section>
        }
        else if (Model.ActiveTab == "background")
        {
            <section class="admin-section"><div class="admin-section-heading"><div><p class="eyebrow">BACKGROUND</p><h2>背景素材</h2></div><form action="/admin/background/clear" method="post">@Html.AntiForgeryToken()<button class="secondary-button" type="submit">清除目前背景</button></form></div>
                <div class="background-tools">
                    <form class="admin-form" action="/admin/background/upload" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<h3>上傳圖片或影片</h3><label>名稱（選填）<input name="name" maxlength="128" /></label><label>檔案<input name="file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm" required /></label><small>支援 JPG、PNG、WEBP、GIF、MP4、WEBM，最大 50 MB。</small><button class="primary-button" type="submit">上傳背景</button></form>
                    <form class="admin-form" action="/admin/background/url" method="post">@Html.AntiForgeryToken()<h3>新增影片網址</h3><label>名稱（選填）<input name="name" maxlength="128" /></label><label>YouTube／Bilibili 網址<input name="url" type="url" required placeholder="https://www.youtube.com/watch?v=..." /></label><small>抖音／TikTok 請先下載為 MP4 再上傳。</small><button class="primary-button" type="submit">新增連結</button></form>
                </div>
                <div class="background-grid">
                    @foreach (var asset in Model.Backgrounds)
                    {
                        <article class="background-card @(asset.IsActive ? "is-active" : "")"><div class="background-preview">@if (asset.MimeType.StartsWith("image/")) { <img src="@asset.FileUrl" alt="" /> } else if (asset.MimeType.StartsWith("video/")) { <video muted><source src="@asset.FileUrl" type="@asset.MimeType" /></video> } else { <iframe src="@asset.FileUrl" title="@asset.Name" tabindex="-1"></iframe> }</div><div><h3>@asset.Name</h3><small>@asset.MimeType</small></div><div class="row-actions">@if (!asset.IsActive) { <form action="/admin/background/activate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@asset.Id" /><button type="submit">設為背景</button></form> } else { <span class="tag">使用中</span> }<form action="/admin/background/delete" method="post" data-confirm="確定刪除此背景素材？">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@asset.Id" /><button class="danger-button" type="submit">刪除</button></form></div></article>
                    }
                    @if (Model.Backgrounds.Count == 0) { <div class="empty-state">尚無背景素材</div> }
                </div>
            </section>
        }
        else
        {
            <section class="admin-section"><div class="admin-section-heading"><div><p class="eyebrow">ACCESS CONTROL</p><h2>會員權限管理</h2></div></div><div class="admin-list">
                @foreach (var item in Model.Members)
                {
                    <div class="permission-row"><div><strong>@item.Member.Email</strong><small>建立於 @item.Member.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</small></div><form action="/admin/member/name" method="post">@Html.AntiForgeryToken()<input type="hidden" name="userId" value="@item.Member.Id" /><input name="name" maxlength="64" value="@item.Member.Name" required /><button type="submit">更新名稱</button></form><form action="/admin/member/role" method="post">@Html.AntiForgeryToken()<input type="hidden" name="userId" value="@item.Member.Id" /><select name="role"><option value="user" selected="@(item.Member.Role == "user" ? "selected" : null)">一般用戶</option><option value="admin" selected="@(item.Member.Role == "admin" ? "selected" : null)">管理員</option></select><button type="submit">更新角色</button></form></div>
                }
            </div></section>
        }
    </div>
</section>
