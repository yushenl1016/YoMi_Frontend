@model OrderFormViewModel
@{
    ViewData["Title"] = "立即下單"; ViewData["ReferencePage"] = true; ViewData["PageClass"] = "order-page";
    var input = Model.Input;
    var hasOptions = Model.Item?.Options.Count > 0;
    var selectedOption = Model.Item?.Options.FirstOrDefault(x => x.Id == input.OptionId);
    var fixedPrice = hasOptions || Model.Item?.OrderUnitPrice.HasValue == true;
    var unitPrice = hasOptions ? selectedOption?.UnitPrice : Model.Item?.OrderUnitPrice;
    var unit = Model.Item?.OrderUnit ?? "單";
    // A price-list link to a server-tagged option arrives without a server; preselect it so the option stays valid.
    var server = input.GameServer ?? selectedOption?.Server;
    var choosing = Model.Item == null && !input.IsCustom;
    var steps = new[] { "選擇服務", input.IsCustom ? "描述需求" : "填寫資料", fixedPrice || choosing ? "確認金額" : "客服報價" };
}
@section Styles { <link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/order-options.js" asp-append-version="true" defer></script> }
<header class="replica-heading"><div class="container heading-content">
    <div class="heading-logo"><img src="@(ViewData["LogoUrl"])" alt="悠咪電競" /><span>ORDER</span></div>
    <div><p class="replica-eyebrow">BOOK YOUR NEXT GAME</p><h1>立即下單</h1><p>選擇服務，確認需求，我們陪你完成下一場挑戰。</p></div>
</div></header>
<section class="container order-content">
    <partial name="_Navigation" model='@("new")' />
    <ol class="order-steps" aria-label="下單步驟">
    @for (var i = 0; i < steps.Length; i++)
    {
        var current = i == (choosing ? 0 : 1);
        <li class="@(current ? "is-current" : i < (choosing ? 0 : 1) ? "is-done" : null)" aria-current="@(current ? "step" : null)"><span>@((i + 1).ToString("00"))</span>@steps[i]</li>
    }
    </ol>
    <div asp-validation-summary="All" class="order-error" role="alert"></div>
    @if (choosing)
    {
        <div class="order-menu">
        @foreach (var category in Model.Items.GroupBy(x => x.Tab))
        {
            <section class="order-menu-section">
                <h2 class="order-category"><span>@category.Key</span><small>@category.Count() 項服務</small></h2>
                <ul class="order-menu-items">
                @foreach (var item in category)
                {
                    <li><a class="order-service" asp-action="New" asp-route-itemId="@item.Id"><span class="order-service-line"><span class="order-service-name">@item.Name</span><i aria-hidden="true"></i>@if (item.Options.Count > 0) { <strong>@item.DisplayPrice</strong> } else if (item.OrderUnitPrice.HasValue) { <strong><small>NT$</small>@item.OrderUnitPrice.Value.ToString("#,0.##")<small>/ @item.OrderUnit</small></strong> } else { <strong class="is-quote">價格洽詢</strong> }</span>@if (!string.IsNullOrWhiteSpace(item.Note)) { <span class="order-service-note">@item.Note</span> }</a></li>
                }
                </ul>
            </section>
        }
            @if (Model.Items.Count == 0) { <p class="order-menu-empty">目前尚無開放下單的服務。</p> }
            <div class="order-menu-foot"><h3>找不到你想要的單？</h3><p>寫下你想玩的內容與目標，由客服協助確認服務及報價。</p><a class="secondary-button" asp-action="New" asp-route-custom="true">提出想打的單 →</a></div>
        </div>
    }
    else
    {
        <a asp-action="New" class="order-back">← 重新選擇服務</a>
        <div class="order-layout"><div class="order-panel">
            <form asp-action="@(fixedPrice ? "Review" : "Create")" method="post" class="order-form">
                <input type="hidden" name="RequestId" value="@input.RequestId" /><input type="hidden" name="ItemId" value="@input.ItemId" />
                <input type="hidden" name="IsCustom" value="@input.IsCustom.ToString().ToLowerInvariant()" />
                <div class="order-form-head"><h2>@(input.IsCustom ? "提出想打的單" : Model.Item.Name)</h2><p class="order-muted">@(input.IsCustom ? "告訴我們你想玩的遊戲、目標與需求，客服會再與你確認報價。" : Model.Item.Note)</p></div>
                @if (input.IsCustom)
                {
                    <div class="order-field order-field-wide"><label for="custom-service">想打什麼單？</label><input id="custom-service" name="CustomService" value="@input.CustomService" maxlength="128" placeholder="例如：特定地圖陪玩、任務挑戰" required /></div>
                }
                <div class="order-field"><label for="game-account">遊戲暱稱／ID</label><input id="game-account" name="GameAccount" value="@input.GameAccount" maxlength="128" required autocomplete="off" /></div>
                <div class="order-field"><label for="game-server">伺服器</label>
                <select id="game-server" name="GameServer" required data-order-server>
                    <option value="">請選擇伺服器</option>
                    <option value="台服" selected="@(server == "台服")">台服</option>
                    <option value="陸服" selected="@(server == "陸服")">陸服</option>
                </select></div>
                @if (hasOptions)
                {
                    <div class="order-field order-field-wide"><label for="order-option">服務子項目</label>
                        <select id="order-option" name="OptionId" required data-order-option>
                            <option value="">請選擇子項目</option>
                            @foreach (var option in Model.Item.Options.OrderBy(x => x.SortOrder).ThenBy(x => x.Id))
                            {
                                <option value="@option.Id" selected="@(input.OptionId == option.Id)" data-server="@option.Server" data-name="@(option.Server == null ? option.Name : option.Server + "・" + option.Name)" data-price="@option.UnitPrice.ToString("#,0.##")">@(option.Server == null ? "" : option.Server + "・")@option.Name — NT$ @option.UnitPrice.ToString("#,0.##") / @unit</option>
                            }
                        </select>
                    </div>
                }
                <div class="order-field order-field-wide"><label for="order-quantity">數量（@unit）</label><input id="order-quantity" name="Quantity" type="number" value="@input.Quantity" min="1" max="1000" step="1" required />
                @if (Model.Item?.WeeklyLimit.HasValue == true) { <small>最近七天最多 @Model.Item.WeeklyLimit @unit；待付款訂單也會保留名額。</small> }</div>
                <div class="order-field order-field-wide"><label for="order-contact">Discord／LINE 聯絡帳號</label><input id="order-contact" name="Contact" value="@input.Contact" maxlength="200" placeholder="請註明使用的平台與帳號" required /></div>
                <div class="order-field order-field-wide"><label for="order-requirements">@(fixedPrice ? "服務需求／希望時間（選填）" : "特殊單需求")</label><textarea id="order-requirements" name="Requirements" rows="5" maxlength="2000" required="@(!fixedPrice)" placeholder="描述你的需求與希望時間，客服會再與你確認安排。">@input.Requirements</textarea></div>
                <button class="primary-button" type="submit">@(fixedPrice ? "下一步：確認金額 →" : "送出並聯絡客服 →")</button>
            </form>
        </div><div class="order-summary-column"><aside class="order-panel order-summary"><p class="replica-eyebrow">YOUR ORDER</p>
            <h2>@(input.IsCustom ? "自訂需求" : Model.Item.Name)</h2>
            @if (hasOptions) { <p class="order-selected-option" data-option-name>@(selectedOption?.Server == null ? selectedOption?.Name : selectedOption.Server + "・" + selectedOption.Name)</p> }
            <div class="order-summary-price" aria-live="polite"><strong class="order-total" data-option-price>@(unitPrice.HasValue ? $"NT$ {unitPrice.Value:#,0.##}" : hasOptions ? "請選擇子項目" : "價格未定")</strong>@if (fixedPrice) { <span>/ @unit</span> }</div>
            <ul class="order-summary-notes">
                <li>@(fixedPrice ? "下一步確認數量與會員優惠後再付款。" : "先送出需求並聯絡客服；報價確認後，再回訂單查看付款資訊。")</li>
                @if (fixedPrice) { <li>@(Model.Item.AllowVipDiscount ? "VIP、生日與專屬折扣擇優計算，不疊加；專屬折扣可在確認訂單時選擇。" : "此服務為固定價，不適用會員折扣。")</li> }
                <li>@(input.IsCustom ? "是否計入 VIP 累積，由客服報價時確認。" : Model.Item.CountsForVip ? "此服務可累積 VIP 消費。" : "此服務不計入 VIP 累積。")</li>
            </ul>
            <a class="order-summary-link" href="/my-records">前往「我的消費」設定生日 →</a>
        </aside>
        @if (!string.IsNullOrEmpty(Model.Item?.ImageKey))
        {
            <a class="order-service-image" href="@Url.Content("~/" + Model.Item.ImageKey)" target="_blank" rel="noopener" aria-label="@(Model.Item.Name + "服務圖片，開啟原圖")"><img src="@Url.Content("~/" + Model.Item.ImageKey)" alt="@(Model.Item.Name + "服務價目說明")" /></a>
        }
        </div></div>
    }
</section>
