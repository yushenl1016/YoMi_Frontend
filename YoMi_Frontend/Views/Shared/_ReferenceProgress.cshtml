@model VipStatus
@{
    var nextTier = VipRules.Tiers.FirstOrDefault(tier => tier.Level == Model.EarnedTier.Level + 1);
}
<div class="replica-progress @Model.EarnedTier.CssClass" style="@Model.EarnedTier.InlineStyle" role="progressbar" aria-label="VIP 累積消費升級進度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.Progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">
    <span class="@(nextTier?.CssClass)" style="width:@Model.Progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;@nextTier?.InlineStyle"></span>
</div>
