@model VipStatus
@{
    var nextTier = VipRules.Tiers.FirstOrDefault(tier => tier.Level == Model.Tier.Level + 1);
}
<div class="replica-progress @Model.Tier.CssClass" role="progressbar" aria-label="VIP 升級進度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.Progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">
    <span class="@(nextTier?.CssClass) @(Model.Tier.Level == 4 ? "rainbow-progress" : "")" style="width:@Model.Progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span>
</div>
