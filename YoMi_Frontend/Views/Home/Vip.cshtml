@model VipPageViewModel
@{
    ViewData["Title"] = "VIP 等級";
}

<header class="page-hero"><div class="hero-grid"></div><div class="container"><img class="page-logo" src="@(ViewData["LogoUrl"])" alt="悠咪電競 Logo" /><p class="eyebrow">VIP MEMBERSHIP</p><h1>悠咪 VIP 等級</h1><p>累積消費自動升級，越高等級享有越多尊榮福利。</p></div></header>

<section class="page-content">
    <div class="container narrow">
        @if (Model.Status != null)
        {
            <section class="member-status @Model.Status.Tier.CssClass">
                <div><span class="vip-icon">@Model.Status.Tier.Icon</span><p>目前等級</p><h2>@Model.Status.Tier.Name</h2></div>
                <div class="status-total"><span>累積消費</span><strong>NT$@Model.Status.Total.ToString("N0")</strong></div>
                <div class="progress-block"><div class="progress-label"><span>升級進度</span>@if (Model.Status.NextThreshold.HasValue) { <span>尚差 NT$@((Model.Status.NextThreshold.Value - Model.Status.Total).ToString("N0"))</span> } else { <span>已達最高等級</span> }</div><div class="progress-track"><span style="width:@Model.Status.Progress.ToString("0.##")%"></span></div></div>
            </section>
        }
        else
        {
            <aside class="login-prompt"><span>⭐</span><div><h2>登入查看你的 VIP 進度</h2><p>消費紀錄與會員等級將集中顯示。</p></div><a class="primary-button" href="/account?returnUrl=/vip">會員登入</a></aside>
        }

        <div class="vip-tier-list">
            @foreach (var tier in Model.Tiers)
            {
                <article class="vip-tier-card @tier.CssClass">
                    <div class="tier-summary"><span class="vip-icon">@tier.Icon</span><div><p>累積 NT$@tier.Threshold.ToString("N0")</p><h2>@tier.Name @if (!string.IsNullOrWhiteSpace(tier.Tag)) { <small>@tier.Tag</small> }</h2><strong>@tier.DiscountLabel</strong></div></div>
                    <ul>@foreach (var benefit in tier.Benefits) { <li><span>✓</span>@benefit</li> }</ul>
                </article>
            }
        </div>

        <aside class="notice-card"><h3>VIP 補充規則</h3><ul><li>VIP 等級越高，可同時享有所有低階 VIP 福利。</li><li>存單金額可累積計算，用於提升 VIP 等級。</li><li>排位相關消費（帳號租借、代練等）不列入 VIP 累積。</li><li>代解 3x3、代儲及趣味單為固定價位，不適用 VIP 優惠。</li><li>銀牌與金牌 VIP 累積消費僅保留 14 天，白金以上由客服主動統計。</li><li>若超過一個月未下單，VIP 等級將自動降一階。</li></ul></aside>
    </div>
</section>
