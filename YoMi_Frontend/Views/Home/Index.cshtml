@model HomePageViewModel
@{
    ViewData["Title"] = "首頁";
    ViewData["HomeReplica"] = true;
    var announcement = Model.Get("announcement");
    var siteName = Model.Get("site_name", "悠咪電競");
    var siteSubtitle = Model.Get("site_subtitle", "YUMI ESPORTS");
    var description = Model.Get("site_description", "專業三角洲陪玩平台，給予最專業的服務及實力。護航、趣味單、代儲等多元服務，累積消費解鎖 VIP 等級，享受專屬折扣與尊榮福利。");
    var icons = Url.Content("~/images/home-icons.svg");
    var services = new[] {
        ("zap", "護航服務"), ("shield", "趣味單"), ("trophy", "代儲值"), ("star", "陪玩服務"),
        ("zap", "代打代練"), ("shield", "帳號安全"), ("trophy", "VIP 福利"), ("star", "精英打手")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}

@if (!string.IsNullOrWhiteSpace(announcement))
{
    <aside class="announcement" data-dismissible>
        <div class="announcement-inner"><strong>公告</strong><span>@announcement</span><button type="button" aria-label="關閉公告">✕</button></div>
    </aside>
}

<section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-bg-panel" aria-hidden="true"></div>
    <div class="hero-layout">
        <div class="hero-copy">
            <div class="hero-glow hero-glow-cyan" aria-hidden="true"></div>
            <div class="hero-glow hero-glow-yellow" aria-hidden="true"></div>
            <p class="eyebrow">PROFESSIONAL ESPORTS PLATFORM</p>
            <h1><span>追求</span><strong>極致</strong><em>ESPORTS</em></h1>
            <p class="hero-description">@description</p>
            <div class="hero-actions">
                <a class="primary-button" href="/orders/new">立即下單</a>
                <a class="primary-button" href="/price">查看價目表 <svg class="home-icon" aria-hidden="true"><use href="@(icons)#chevron" /></svg></a>
                <a class="secondary-button" href="/vip">VIP 等級說明</a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="pink-button" href="/email-auth">登入 / 註冊會員</a>
                }
                else
                {
                    @* The original homepage keeps this CTA visible after login; no authentication action. *@
                    <button class="pink-button" type="button" aria-disabled="true">登入 / 註冊會員</button>
                }
            </div>
            <ul class="trust-list" aria-label="服務特色">
                <li>專業陪玩平台</li><li>帳號安全保障</li><li>多元服務項目</li>
            </ul>
        </div>

        <aside class="brand-panel" aria-label="品牌資訊">
            <span class="panel-label">YUMI CLUB</span>
            <div class="hero-logo-wrap"><img class="hero-logo" src="@(ViewData["LogoUrl"])" alt="悠咪電競 Logo" /></div>
            <h2>@siteName</h2>
            <p>@siteSubtitle</p>
            <div class="preview-stats">
                <div><strong>5 階</strong><span>VIP 等級</span></div>
                <div><strong>85折</strong><span>壽星優惠</span></div>
                <div><strong>9折</strong><span>至尊折扣</span></div>
                <div><strong>多元</strong><span>服務項目</span></div>
            </div>
        </aside>
    </div>
</section>

<section class="service-strip" aria-label="服務項目">
    <div class="service-marquee">
        @for (var copy = 0; copy < 2; copy++)
        {
            <div class="service-list" aria-hidden="@(copy == 1 ? "true" : "false")">
                @foreach (var service in services)
                {
                    <span><svg class="home-icon" aria-hidden="true"><use href="@(icons)#@service.Item1" /></svg>@service.Item2<b aria-hidden="true">◆</b></span>
                }
            </div>
        }
    </div>
</section>

<section class="content-section home-vip">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container">
        <div class="section-heading"><p class="eyebrow">VIP SYSTEM</p><h2>VIP 等級一覽</h2><p>累積消費自動升級，享受更多專屬折扣與尊榮福利</p></div>
        <div class="vip-card-grid">
            @foreach (var tier in VipRules.Tiers)
            {
                // Homepage summary copy only; the shared benefits/calculation rules stay unchanged.
                var discount = tier.Level == 3 ? "97折起" : $"{tier.Discount * 100:0.##}折";
                if (tier.Level == 5) { discount = "9折"; }
                <article class="vip-mini-card @tier.CssClass">
                    <span class="vip-icon">@tier.Icon</span><h3 class="vip-tier-name">@tier.Name</h3><p>NT$@tier.Threshold.ToString("N0")+</p><strong class="home-discount">@discount</strong>
                </article>
            }
        </div>
        <div class="center"><a class="secondary-button" href="/vip">查看完整 VIP 福利 <svg class="home-icon" aria-hidden="true"><use href="@(icons)#chevron" /></svg></a></div>
    </div>
</section>

<section class="content-section feature-section">
    <div class="container">
        <div class="section-heading"><p class="eyebrow">SERVICES</p><h2>我們的服務</h2></div>
        <div class="home-services">
            <article class="home-service">
                <div class="service-icon-panel"><svg class="home-icon" aria-hidden="true"><use href="@(icons)#zap" /></svg></div>
                <div class="service-description"><p class="service-tag">ESCORT</p><h3>護航 &amp; 趣味單</h3><p>專業高段位打手快速接單，護航、趣味單、代打代練，讓你的遊戲體驗更上一層樓。</p></div>
            </article>
            <article class="home-service">
                <div class="service-icon-panel"><svg class="home-icon" aria-hidden="true"><use href="@(icons)#shield" /></svg></div>
                <div class="service-description"><p class="service-tag">SECURITY</p><h3>帳號安全保障</h3><p>嚴格審核打手資格，全程保障帳號安全，讓你放心委託，無後顧之憂。</p></div>
            </article>
            <article class="home-service">
                <div class="service-icon-panel"><svg class="home-icon" aria-hidden="true"><use href="@(icons)#trophy" /></svg></div>
                <div class="service-description"><p class="service-tag">RECHARGE</p><h3>代儲值服務</h3><p>安全快速的代儲服務，多種遊戲支援，省時省力，讓你專注在遊戲本身。</p></div>
            </article>
        </div>
    </div>
</section>

<footer class="home-footer">
    <div class="container home-footer-inner">
        <div class="home-footer-brand">
            <div class="footer-brand"><img class="footer-logo" src="@(ViewData["LogoUrl"])" alt="" loading="lazy" /><strong>@siteName</strong></div>
            <p>@description.Split('\n')[0]</p>
            <p class="home-copyright">@Model.Get("footer_text", $"© {DateTime.Now.Year} 悠咪電競 · 保留所有權利")</p>
        </div>
        <div class="home-contact">
            <p class="eyebrow">CONTACT</p><h3>聯絡我們</h3><p>有任何問題歡迎透過以下方式聯繫</p>
            <a class="discord-button" href="@Model.Get("contact_discord", "https://discord.gg/yummi-esports-club")" target="_blank" rel="noopener noreferrer"><strong>Discord</strong><span aria-hidden="true">·</span><span>yummi-esports-club</span></a>
            @if (!string.IsNullOrWhiteSpace(Model.Get("contact_line")))
            {
                <a class="secondary-button" href="@Model.Get("contact_line")" target="_blank" rel="noopener">LINE 聯絡</a>
            }
        </div>
    </div>
</footer>
