@model PasswordSetupViewModel
@{ ViewData["Title"] = "設定登入密碼"; }
@section Styles { <link rel="stylesheet" href="~/css/email-auth.css" asp-append-version="true" /> }
<section class="member-auth" aria-labelledby="auth-title"><div class="member-auth-card">
    <h1 id="auth-title">設定登入密碼</h1>
    <p class="member-auth-intro">設定後可用相同 Email 搭配 Google 或密碼登入。</p>
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    <form action="/account/password" method="post" class="member-auth-form">
        @Html.AntiForgeryToken()
        <label for="new-password">密碼</label><input id="new-password" name="Password" type="password" required minlength="8" maxlength="128" autocomplete="new-password" autofocus />
        <label for="confirm-password">確認密碼</label><input id="confirm-password" name="ConfirmPassword" type="password" required minlength="8" maxlength="128" autocomplete="new-password" />
        <button class="member-auth-primary" type="submit">儲存密碼</button>
    </form>
    <a class="member-auth-back" href="/my-records">返回會員頁面</a>
</div></section>
