@model AccountViewModel
@{ ViewData["Title"] = "登入或註冊"; }
@section Styles { <link rel="stylesheet" href="~/css/email-auth.css" asp-append-version="true" /> }
<section class="member-auth" aria-labelledby="auth-title"><div class="member-auth-card">
    <img class="member-auth-logo" src="@(ViewData["LogoUrl"])" alt="悠咪電競" />
    <p class="member-auth-kicker">WELCOME TO YUMI</p>
    <h1 id="auth-title">登入或註冊</h1>
    <p class="member-auth-intro">歡迎回到悠咪，繼續你的遊戲時光。</p>
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    @if (ViewData["GoogleEnabled"] is true)
    {
        <form action="/account/google" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" /><input asp-for="ReferralCode" type="hidden" />
            <button class="member-auth-provider" type="submit"><span class="google-mark" aria-hidden="true">G</span>使用 Google 登入</button>
        </form>
        <div class="member-auth-divider"><span>或者</span></div>
    }
    <form action="/account/check-email" method="post" class="member-auth-form">
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" /><input asp-for="ReferralCode" type="hidden" />
        <label for="auth-email">Email</label>
        <input id="auth-email" name="Email" value="@Model.Email" type="email" maxlength="320" required autocomplete="email" placeholder="請輸入你的電子郵件地址" autofocus />
        <button class="member-auth-primary" type="submit">繼續 <span aria-hidden="true">→</span></button>
    </form>
    <p class="member-auth-note">舊站會員也請先輸入你想使用的 Email。</p>
    <a class="member-auth-back" href="/">返回首頁</a>
</div></section>
